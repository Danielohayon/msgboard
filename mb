    if a == "comment":
        args.text = rest
        text = read_text(args)
        m = api(args, "POST", "/api/bundles/%d/comment" % bid, body={"user": me, "text": text})
        print("commented [#%d] on bundle #%d" % (m["id"], bid))
        return 0
    if a == "wait":
        d = api(args, "GET", "/api/bundles/%d" % bid)
        return pr_wait(args, d["root"]["id"], "waiting for comments on bundle #%d" % bid)
    if a in ("add-pr", "remove-pr"):
        ids = [x.lstrip("#") for x in " ".join(rest).replace(",", " ").split()]
        if not ids:
            die("usage: mb bundle %s <bundle-id> <pr-id> [pr-id ...]" % a)
        b = api(args, "POST", "/api/bundles/%d" % bid, body={"user": me, ("add_prs" if a == "add-pr" else "remove_prs"): ids})
        print("bundle #%d now has %d PR%s: %s" % (bid, b["pr_count"], "" if b["pr_count"] == 1 else "s", " -> ".join("#%d" % i for i in b["merge_order"]) or "-"))
        return 0
    if a == "order":
        ids = [x.lstrip("#") for x in " ".join(rest).replace(",", " ").replace("->", " ").split()]
        b = api(args, "POST", "/api/bundles/%d" % bid, body={"user": me, "order": ids})
        print("bundle #%d merge order: %s" % (bid, " -> ".join("#%d" % i for i in b["merge_order"])))
        return 0
    if a in ("open", "merged", "closed", "close", "reopen"):
        status = {"close": "closed", "reopen": "open"}.get(a, a)
        b = api(args, "POST", "/api/bundles/%d" % bid, body={"user": me, "status": status})
        print("bundle #%d is now %s" % (bid, b["status"]))
        return 0
    if a == "tag":
        add, remove = split_tag_ops(rest)
        b = api(args, "POST", "/api/bundles/%d" % bid, body={"user": me, "add_tags": add, "remove_tags": remove})
        print("bundle #%d tags: %s" % (bid, ", ".join(b["tags"]) or "-"))
        return 0
    if a == "priority":
        if not rest:
            die("usage: mb bundle priority <id> <1-100>   (1 = merge first; P0..P3 = 1/10/50/90)")
        b = api(args, "POST", "/api/bundles/%d" % bid, body={"user": me, "priority": rest[0]})
        print("bundle #%d priority %s" % (bid, prio(b["priority"])))
        return 0
    if a == "edit":
        body = {"user": me}
        for f in ("title", "body"):
            v = getattr(args, f, None)
            if v is not None:
                body[f] = v
        if args.file:
            with open(args.file) as f:
                body["body"] = f.read()
        if len(body) == 1:
            die("nothing to change: use --title/--body/--file")
        b = api(args, "POST", "/api/bundles/%d" % bid, body=body)
        print("updated " + fmt_bundle(b))
        return 0
    die("unknown bundle action %r" % a)


