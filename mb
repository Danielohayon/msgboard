HERE = os.path.dirname(os.path.realpath(__file__))
REPO_LAYOUT = os.path.exists(os.path.join(HERE, "server.py"))
DATA_DIR = os.environ.get("MB_DATA_DIR") or (os.path.join(HERE, "data") if REPO_LAYOUT else os.path.expanduser("~/.msgboard"))


def save_config(**fields):
    """Merge fields into DATA_DIR/config.json (the fallback identity for shells without a Claude session id)."""
    os.makedirs(DATA_DIR, exist_ok=True)
    path = os.path.join(DATA_DIR, "config.json")
    try:
        with open(path) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    cfg.update({k: v for k, v in fields.items() if v is not None})
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=1)
    os.replace(tmp, path)
    return path


def load_config():
    """~/.msgboard/config.json (or $MB_DATA_DIR/config.json): url, token, user, project, remote, reconnect_secs."""
    try:
        with open(os.path.join(DATA_DIR, "config.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


CONFIG = load_config()
DEFAULT_URL = os.environ.get("MB_URL") or CONFIG.get("url") or "http://127.0.0.1:8765"
IDENTITIES = os.path.join(DATA_DIR, "identities.json")
SESSION_ID = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
CODEX_THREAD = os.environ.get("CODEX_THREAD_ID") or ""  # Codex sets it for the shell commands of one thread
SERVER_MAX_POLL = 30  # server caps one long-poll at 30s; the client loops
RECONNECT_SECS = int(os.environ.get("MB_RECONNECT_SECS") or CONFIG.get("reconnect_secs") or 600)
REMOTE = os.environ.get("MB_REMOTE") or CONFIG.get("remote") or ""  # set on remote machines: the name of this machine
DEFAULT_PROJECT = "main"


def die(msg, code=1):
    print("mb: " + msg, file=sys.stderr, flush=True)
    sys.exit(code)


# ----------------------------------------------------------------- identity

def load_identities():
    try:
        with open(IDENTITIES) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_identity(session, **fields):
    os.makedirs(DATA_DIR, exist_ok=True)
    ids = load_identities()
    cur = ids.get(session) or {}
    cur.update({k: v for k, v in fields.items() if v is not None})
    cur["ts"] = time.time()
    cur["cwd"] = os.getcwd()
    ids[session] = cur
    tmp = "%s.%d.tmp" % (IDENTITIES, os.getpid())
    with open(tmp, "w") as f:
        json.dump(ids, f, indent=1)
    os.replace(tmp, IDENTITIES)


def session_identity():
    """The identity bound to this Claude Code session or Codex thread (by `mb join`, `mb claude`, `mb codex`)."""
    if not (SESSION_ID or CODEX_THREAD):
        return {}
    ids = load_identities()
    return (ids.get(CODEX_THREAD) if CODEX_THREAD else None) or (ids.get(SESSION_ID) if SESSION_ID else None) or {}


_under_daemon = None


def under_codex_daemon():
    """True when this process descends from Codex's shared app-server daemon (interactive Codex runs its shell
    commands there), whose environment belongs to whoever started it, not to this thread."""
    global _under_daemon
    if _under_daemon is not None:
        return _under_daemon
    _under_daemon = False
    try:
        out = subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True, timeout=5).stdout
        tree = {}
        for line in out.splitlines():
            parts = line.split(None, 2)
            if len(parts) >= 2:
                tree[int(parts[0])] = (int(parts[1]), parts[2] if len(parts) > 2 else "")
        pid = os.getppid()
        for _ in range(15):
            ppid, cmd = tree.get(pid, (0, ""))
            if "app-server" in cmd and "codex" in cmd:
                _under_daemon = True
                break
            if ppid <= 1:
                break
            pid = ppid
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return _under_daemon


def env_identity(var):
    """MB_USER / MB_PROJECT from the environment. Not inside an unbound Codex thread that runs under the shared
    daemon: there the variables are the daemon's (inherited from whichever session started it)."""
    val = os.environ.get(var)
    if val and CODEX_THREAD and under_codex_daemon():
        return None
    return val


def config_identity_allowed():
    """The config-file identity (written by `mb join` in a plain terminal) is for humans typing at a terminal.
    Agents and scripts run without a TTY and must identify themselves (session binding, --as, MB_USER), so a stale
    default can never attribute their posts to someone else."""
    return os.environ.get("MB_USE_CONFIG_IDENTITY") == "1" or (sys.stdin.isatty() and sys.stdout.isatty())


def resolve_user(args, required=True):
    bound = session_identity()
    name = (getattr(args, "as_", None) or (bound.get("name") if CODEX_THREAD else None)  # a bound Codex thread beats the daemon's env
            or env_identity("MB_USER") or bound.get("name")
            or (CONFIG.get("user") if config_identity_allowed() else None))
    if not name and required:
        die("no identity yet. Run `mb join <name> -p <project>` (or just `mb join` for an auto name) first; "
            "or pass --as <name> / set MB_USER.")
    return name


def resolve_project(args):
    bound = session_identity()
    return (getattr(args, "project", None) or (bound.get("project") if CODEX_THREAD else None)
            or env_identity("MB_PROJECT") or bound.get("project")
            or (CONFIG.get("project") if config_identity_allowed() else None) or None)


# ----------------------------------------------------------------- http

class Unreachable(Exception):
    pass


class UnixHTTPConnection(http.client.HTTPConnection):
    """HTTP over a Unix socket (the reverse tunnel on a remote machine ends in one)."""

    def __init__(self, path, timeout=None):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.timeout)
        sock.connect(self.unix_path)
        self.sock = sock


def base_url(args):
    url = getattr(args, "url", None) or DEFAULT_URL
    return url if url.startswith("unix://") else url.rstrip("/")


def connection(base, timeout):
    if base.startswith("unix://"):
        return UnixHTTPConnection(base[len("unix://"):], timeout=timeout)
    u = urllib.parse.urlsplit(base)
    if u.scheme == "https":
        return http.client.HTTPSConnection(u.hostname, u.port or 443, timeout=timeout)
    return http.client.HTTPConnection(u.hostname or "127.0.0.1", u.port or 80, timeout=timeout)


def unreachable_msg(base, reason):
    if REMOTE:
        return ("board not reachable via %s (%s). The tunnel from the board host to this machine (%s) is down; "
                "wait a minute and retry. `mb wait`/`mb follow` keep retrying by themselves for %d min."
                % (base, reason, REMOTE, RECONNECT_SECS // 60))
    return "server not reachable at %s (%s). Start it with: mb serve -d" % (base, reason)


def api(args, method, path, params=None, body=None, timeout=20, die_on_unreachable=True):
    base = base_url(args)
    if params:
        params = {k: v for k, v in params.items() if v is not None}
        path += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode("utf-8") if body is not None else None
    headers = {"Content-Type": "application/json", "Host": "localhost"}
    token = getattr(args, "token", None) or os.environ.get("MB_TOKEN") or CONFIG.get("token")
    if token:
        headers["Authorization"] = "Bearer " + token
    try:
        conn = connection(base, timeout)
        conn.request(method, path, body=data, headers=headers)
        resp = conn.getresponse()
        raw = resp.read()
        conn.close()
    except (OSError, http.client.HTTPException) as e:
        if not die_on_unreachable:
            raise Unreachable(str(e) or e.__class__.__name__)
        die(unreachable_msg(base, str(e) or e.__class__.__name__))
    try:
        payload = json.loads(raw.decode("utf-8"))
    except ValueError:
        payload = {"error": "non-JSON response (%d): %s" % (resp.status, raw[:200].decode("utf-8", "replace"))}
    if resp.status >= 400:
        die("%s" % (payload.get("error") if isinstance(payload, dict) else payload))
    return payload


def health(args):
    try:
        return api(args, "GET", "/api/health", timeout=3, die_on_unreachable=False)
    except Unreachable:
        return None
    except SystemExit:
        return None


# ----------------------------------------------------------------- output

def fmt_ts(ts):
    return datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M") if ts else "-"


def rel(ts):
    if not ts:
        return "never"
    s = max(0, time.time() - ts)
    if s < 60:
        return "just now"
    if s < 3600:
        return "%dm ago" % (s // 60)
    if s < 86400:
        return "%dh ago" % (s // 3600)
    return "%dd ago" % (s // 86400)


def fmt_dur(secs):
    secs = int(max(0, secs))
    if secs < 60:
        return "%ds" % secs
    if secs < 3600:
        return "%dm" % (secs // 60)
    if secs < 86400:
        return "%dh%02dm" % (secs // 3600, (secs % 3600) // 60)
    return "%dd%02dh" % (secs // 86400, (secs % 86400) // 3600)


def flags(m):
    f = []
    if m.get("reply_to"):
        f.append("↳#%d" % m["reply_to"])
    kind = m.get("kind") or "message"
    if kind == "ask":
        f.append("✓" if m.get("resolved_ts") else "?")
    elif kind in ("answer", "system", "paste"):
        f.append(kind if kind != "system" else "sys")
    if m.get("pinned_ts"):
        f.append("📌")
    return (" " + " ".join(f)) if f else ""


def fmt_msg(m, show_channel=True):
    head = "[#%d%s] %s %s<%s>" % (m["id"], flags(m), fmt_ts(m["ts"]),
                                   (m["channel"] + " ") if show_channel else "", m["user"])
    if m.get("reply_count"):
        head += " (%d repl%s)" % (m["reply_count"], "ies" if m["reply_count"] != 1 else "y")
    text = m["text"]
    if "\n" in text:
        return head + "\n" + "\n".join("    " + line for line in text.split("\n"))
    return head + " " + text


def emit(msgs, args, show_channel=True):
    for m in msgs:
        if getattr(args, "json", False):
            print(json.dumps(m, ensure_ascii=False), flush=True)
        else:
            print(fmt_msg(m, show_channel), flush=True)


def read_text(args, attr="text"):
    if getattr(args, "file", None):
        with open(args.file) as f:
            return f.read()
    words = getattr(args, attr, None) or []
    if words == ["-"] or (not words and not sys.stdin.isatty()):
        return sys.stdin.read()
    text = " ".join(words)
    if not text.strip():
        die("empty message. Pass text as arguments, `-` to read stdin, or --file PATH.")
    return text


def resolve_channel(args, ref, must_exist=False):
    """'@user' -> DM key; 'name' or 'project/name' -> channel key."""
    if ref.startswith("@"):
        me = resolve_user(args)
        ch = api(args, "GET", "/api/dm", {"as": me, "with": ref[1:]})
        return ch["key"]
    res = api(args, "GET", "/api/resolve", {"channel": ref, "project": resolve_project(args)})
    if must_exist and not res["exists"]:
        hint = (" Did you mean %s?" % ", ".join(res["candidates"])) if res.get("candidates") else ""
        die("no such channel %r.%s `mb channels` lists them; `mb send %s ...` or `mb create %s` creates it."
            % (res["key"], hint, ref, ref))
    return res["key"]


# ----------------------------------------------------------------- server commands

def cmd_serve(args):
    u = urllib.parse.urlsplit(base_url(args))
    host = args.host or u.hostname or "127.0.0.1"
    port = args.port or u.port or 8765
    cmd = [sys.executable, os.path.join(HERE, "server.py"), "--host", host, "--port", str(port),
           "--data-dir", DATA_DIR]
    if not args.daemon:
        os.execv(sys.executable, cmd)
    h = health(args)
    if h:
        print("already running at %s (pid %s)" % (h["url"], h.get("pid")))
        return 0
    os.makedirs(DATA_DIR, exist_ok=True)
    logpath = os.path.join(DATA_DIR, "server.log")
    with open(logpath, "ab") as log:
        p = subprocess.Popen(cmd, stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                             start_new_session=True, cwd=HERE)
    for _ in range(50):
        time.sleep(0.1)
        if p.poll() is not None:
            die("server exited with code %s; see %s" % (p.returncode, logpath))
        h = health(args)
        if h:
            print("msgboard running at %s (pid %d)\nGUI: %s\nlog: %s" % (h["url"], p.pid, h["url"], logpath))
            return 0
    die("server did not become healthy within 5s; see %s" % logpath)


def cmd_stop(args):
    h = health(args)
    pid = h.get("pid") if h else None
    if not pid:
        try:
            with open(os.path.join(DATA_DIR, "server.pid")) as f:
                pid = int(f.read().strip())
        except (OSError, ValueError):
            print("not running")
            return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        print("not running (stale pid %d)" % pid)
        return 0
    for _ in range(50):
        time.sleep(0.1)
        if not health(args):
            print("stopped (pid %d)" % pid)
            return 0
    die("server (pid %d) still answering after 5s" % pid)


def cmd_status(args):
    me = resolve_user(args, required=False)
    if args.text or args.clear:
        if not me:
            die("no identity (mb join <name>)")
        status = "" if args.clear else " ".join(args.text)
        u = api(args, "POST", "/api/users", body={"name": me, "status": status})
        print("%s %s status: %s" % (u["emoji"], me, u["status"] or "(cleared)"))
        return 0
    h = health(args)
    if not h:
        if REMOTE:
            print("board: NOT REACHABLE via %s. The tunnel from the board host to this machine (%s) is down; wait a minute and retry."
                  % (base_url(args), REMOTE))
        else:
            print("server: DOWN at %s  (start: mb serve -d)" % base_url(args))
        return 1
    print("server:   %s  pid %s  up %s%s" % (h["url"], h.get("pid"), rel(time.time() - h["uptime"]).replace(" ago", ""),
                                             "  (token auth)" if h.get("auth") else ""))
    print("counts:   %d users, %d projects, %d channels, %d messages, %d open tasks"
          % (h["users"], h["projects"], h["channels"], h["messages"], h["tasks_open"]))
    try:
        links = api(args, "GET", "/api/links", die_on_unreachable=False)
    except (Unreachable, SystemExit):
        links = []
    for L in links:
        age = fmt_dur(time.time() - (L.get("since") or time.time()))
        print("link:     %-24s %-10s for %s%s" % (L["host"], L["state"], age,
                                                  ("  last error: " + L["last_error"][:80]) if L.get("last_error") and L["state"] != "up" else ""))
    if REMOTE:
        print("remote:   this machine is %s; the board is reached through the tunnel socket" % REMOTE)
    if me:
        u = next((x for x in api(args, "GET", "/api/users") if x["name"] == me), None)
        proj = resolve_project(args) or "(none: mb project use <name>)"
        print("identity: %s %s  project: %s  status: %s" % (u["emoji"] if u else "", me, proj,
                                                              (u or {}).get("status") or "(none: mb status \"...\")"))
    else:
        print("identity: (none: run `mb join <name>`)")
    return 0


def cmd_url(args):
    print(base_url(args))
