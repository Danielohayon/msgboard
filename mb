# ----------------------------------------------------------------- pull requests / bundles

PR_URL_RE = re.compile(r"^https?://\S+$")


def prio(p):
    """priority 1..100, 1 = merge first (shown as p7, p50 ...)."""
    return "%-4s" % ("p%d" % p)


def fmt_review_state(pr):
    if not pr.get("reviews"):
        return "review: pending"
    bits = []
    if pr.get("approvals"):
        bits.append("✅%d %s" % (pr["approvals"], ",".join(pr.get("approvers", []))))
    if pr.get("changes_requested"):
        bits.append("🔁%d" % pr["changes_requested"])
    if pr.get("rejections"):
        bits.append("⛔%d" % pr["rejections"])
    if pr.get("stale_reviews"):
        bits.append("(%d stale)" % pr["stale_reviews"])
    return "review: " + (" ".join(bits) or "pending (stale verdicts only)")


def fmt_pr(pr, show_url=True):
    bundle = (" bundle #%d %s" % (pr["bundle_id"], ("\"%s\"" % pr["bundle_title"]) if pr.get("bundle_title") else "")) if pr.get("bundle_id") else ""
    line = "#%-4d %s %-7s %-48s %s%s  by %s  %d comment%s  %s  %s" % (
        pr["id"], prio(pr["priority"]), pr["status"], pr["title"][:48],
        ("[" + ", ".join(pr["tags"]) + "]") if pr["tags"] else "", bundle, pr["author"], pr["comments"],
        "" if pr["comments"] == 1 else "s", fmt_review_state(pr), rel(pr["updated"]))
    if pr.get("tldr"):
        line += "\n      TL;DR: " + pr["tldr"]
    else:
        line += "\n      ⚠ no TL;DR yet (author: mb pr tldr %d \"what it does and why, in plain words\")" % pr["id"]
    if show_url and pr.get("url"):
        line += "\n      " + pr["url"]
    return line


def fmt_bundle(b):
    return "#%-4d %s %-7s %-40s %d/%d merged  %s  by %s  %d comment%s  %s" % (
        b["id"], prio(b["priority"]), b["status"], b["title"][:40], b["merged_count"], b["pr_count"],
        ("[" + ", ".join(b["tags"]) + "]") if b["tags"] else "", b["created_by"], b["comments"],
        "" if b["comments"] == 1 else "s", rel(b["updated"]))


def print_thread(replies, root, hint):
    print("--- discussion (thread #%d). %s" % (root["id"], hint) if root else "--- (no discussion thread)")
    for r in replies:
        print("  " + fmt_msg(r, show_channel=False).replace("\n", "\n  "))
    if root and not replies:
        print("  (no comments yet)")


def pr_wait(args, root_id, label):
    ns = argparse.Namespace(channel=None, project=None, mention=False, reply_to=root_id, no_threads=False, since=None,
                            peek=False, all=False, timeout=getattr(args, "timeout", None), quiet=False,
                            as_=getattr(args, "as_", None), url=getattr(args, "url", None),
                            token=getattr(args, "token", None), json=getattr(args, "json", False))
    print("(%s: every reply after the entry is returned at once; then new ones as they land)" % label, file=sys.stderr)
    return cmd_wait(ns)


def split_tag_ops(words):
    add, remove = [], []
    for w in words:
        for t in w.split(","):
            t = t.strip()
            if not t:
                continue
            if t.startswith("-") or t.startswith("~"):
                remove.append(t[1:])
            else:
                add.append(t.lstrip("+"))
    return add, remove


