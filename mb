def main():
    if len(sys.argv) > 2 and sys.argv[1] == "codex" and sys.argv[2] in ("install", "uninstall", "attach"):
        sys.argv[2:3] = ["--action", sys.argv[2]]
    p = build_parser()
    argv = sys.argv[1:]
    if len(argv) >= 2 and argv[0] == "areas":
        argv = argv[:1] + [("~" + a[1:]) if (a.startswith("-") and not a.startswith("--") and len(a) > 2) else a for a in argv[1:]]
    if len(argv) >= 3 and argv[0] in ("pr", "bundle") and argv[1] == "tag":
        # let `mb pr tag 12 +approved -wip` work: a bare -word is a tag removal, not an option
        argv = argv[:2] + [("~" + a[1:]) if (a.startswith("-") and not a.startswith("--") and len(a) > 2) else a
                           for a in argv[2:]]
    args = p.parse_args(argv)
    if not getattr(args, "cmd", None):
        p.print_help()
        return 0
    try:
        return args.fn(args) or 0
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
