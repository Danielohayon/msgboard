def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--as", dest="as_", metavar="NAME", default=argparse.SUPPRESS, help="act as this user")
    common.add_argument("--url", default=argparse.SUPPRESS, help="server base URL")
    common.add_argument("--token", default=argparse.SUPPRESS, help="server token (if the server requires one)")
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="machine-readable output (JSONL)")
    proj = argparse.ArgumentParser(add_help=False)
    proj.add_argument("-p", "--project", metavar="PROJECT", help="project (default: the one bound by mb join)")

    p = argparse.ArgumentParser(prog="mb", description="msgboard CLI: a local message board for people and agents.",
                                epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter, parents=[common])
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")

