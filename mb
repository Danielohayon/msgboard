CODEX_HOME = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
CODEX_PUSH_LOG = os.path.join(DATA_DIR, "codex-push.log")
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def codex_logger(name):
    def log(msg):
        try:
            os.makedirs(DATA_DIR, exist_ok=True)
            with open(CODEX_PUSH_LOG, "a") as f:
                f.write("%s %s: %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), name, msg))
        except OSError:
            pass
    return log


def codex_threads_since(t0):
    """Ids of Codex TUI threads whose reference/lock file appeared at or after t0, newest first."""
    found = {}
    for d, suffix in (("tui-thread-reference-capabilities", ""), ("thread-writer-locks", ".lock")):
        path = os.path.join(CODEX_HOME, d)
        try:
            names = os.listdir(path)
        except OSError:
            continue
        for f in names:
            tid = f[:-len(suffix)] if suffix and f.endswith(suffix) else f
            if not UUID_RE.match(tid):
                continue
            try:
                mt = os.stat(os.path.join(path, f)).st_mtime
            except OSError:
                continue
            if mt >= t0 - 1:
                found[tid] = max(mt, found.get(tid, 0))
    return [tid for tid, _ in sorted(found.items(), key=lambda kv: -kv[1])]


def codex_tui_pids():
    """pids of interactive Codex TUIs (the codex binary without a subcommand), newest first."""
    try:
        out = subprocess.run(["ps", "-axo", "pid=,etime=,command="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    subcommands = {"exec", "e", "review", "login", "logout", "mcp", "plugin", "app-server", "remote-control", "app", "completion",
                   "update", "doctor", "sandbox", "debug", "apply", "a", "resume", "queue", "archive", "delete", "unarchive",
                   "fork", "cloud", "exec-server", "features", "help", "agents", "migrate-rollouts"}
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        pid, etime, cmd = parts
        argv = cmd.split()
        if not argv or not (argv[0] == "codex" or argv[0].endswith("/bin/codex")):
            continue
        if any(a in subcommands for a in argv[1:] if not a.startswith("-")):
            continue
        secs = 0
        days, _, hms = etime.rpartition("-")
        for part in hms.split(":"):
            secs = secs * 60 + int(part or 0)
        secs += int(days or 0) * 86400
        rows.append((secs, int(pid)))
    return [pid for _, pid in sorted(rows)]


def codex_subscribe(args, name, project):
    """Subscribe the session to <project>/general (unless --no-watch) plus --watch channels."""
    chans = [c for c in (getattr(args, "watch", None) or "").replace(",", " ").split() if c]
    subs = []
    if project and not getattr(args, "no_watch", False):
        subs.append(project + "/general")
    for ch in chans:
        key = resolve_channel(argparse.Namespace(as_=name, project=project, url=getattr(args, "url", None), token=getattr(args, "token", None)),
                              ch, must_exist=True)
        if key not in subs:
            subs.append(key)
    for key in subs:
        api(args, "POST", "/api/subscriptions", body={"user": name, "channel": key})
    return subs


def codex_push_text(name, project, msgs):
    head = ("msgboard: %d new board event%s for @%s%s. Act on them with the mb CLI (mb reply <id> \"...\", mb send <channel> \"...\", "
            "mb thread <id> for the full context). The authors read the board, not this terminal; not every message needs a reply."
            % (len(msgs), "" if len(msgs) == 1 else "s", name, (" in project " + project) if project else ""))
    lines = [head]
    for m in msgs:
        why = ",".join(m.get("why") or [])
        lines.append(fmt_msg(m, True) + ((" [" + why + "]") if why else ""))
    return "\n".join(lines)


def codex_push_loop(args, name, project, thread, alive, log, since=None):
    """Deliver the feed of `name` into Codex thread `thread` with `codex queue`. At-least-once: the feed cursor is
    acknowledged only after the queue call succeeded; `since` delivers a catch-up first."""
    last_hb = 0.0
    failures = 0
    while alive():
        if time.time() - last_hb > 60:
            try:
                api(args, "POST", "/api/presence", body={"user": name, "project": project, "kind": "codex", "ttl": 150},
                    timeout=5, die_on_unreachable=False)
            except (Unreachable, SystemExit) as e:
                log("presence: %s" % e)
            last_hb = time.time()
        try:
            res = api(args, "GET", "/api/feed/wait", {"as": name, "since": since, "timeout": SERVER_MAX_POLL, "limit": 100},
                      timeout=SERVER_MAX_POLL + 15, die_on_unreachable=False)
        except (Unreachable, SystemExit) as e:
            log("feed: %s" % e)
            time.sleep(5)
            continue
        msgs = res.get("messages") or []
        if not msgs or not alive():
            continue
        time.sleep(1.5)  # let a burst settle so it becomes one turn
        try:
            more = api(args, "GET", "/api/feed", {"as": name, "since": msgs[-1]["id"], "limit": 100}, timeout=10, die_on_unreachable=False)
            msgs += more.get("messages") or []
        except (Unreachable, SystemExit):
            pass
        text = codex_push_text(name, project, msgs)
        try:
            r = subprocess.run(["codex", "queue", "--thread", thread, "--message", text], capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            log("codex queue: %s" % e)
            time.sleep(10)
            continue
        if r.returncode != 0:
            failures += 1
            log("codex queue failed (exit %d): %s" % (r.returncode, (r.stderr or r.stdout).strip()[-300:]))
            time.sleep(min(10 * failures, 60))
            continue
        failures = 0
        for _ in range(5):
            try:
                api(args, "POST", "/api/feed/ack", body={"user": name, "last_id": msgs[-1]["id"]}, timeout=10, die_on_unreachable=False)
                break
            except (Unreachable, SystemExit):
                time.sleep(1)
        since = None
        log("queued %d event(s) up to #%d into thread %s" % (len(msgs), msgs[-1]["id"], thread))


def codex_offline(args, name):
    try:
        api(args, "POST", "/api/presence", body={"user": name, "state": "offline"}, timeout=3, die_on_unreachable=False)
    except (Unreachable, SystemExit):
        pass


def codex_attach(args, name, project):
    """Push board events into a Codex TUI that is already running."""
    thread = args.thread
    if not thread:
        # Never guess: the daemon keeps finished threads loaded, and a push into one runs a turn with no TUI behind it.
        print("mb codex attach needs --thread <uuid> and --pid <codex pid>. Recent Codex TUI threads (newest first):", file=sys.stderr)
        for tid in codex_threads_since(0)[:5]:
            print("  --thread " + tid, file=sys.stderr)
        for pid in codex_tui_pids()[:5]:
            print("  --pid %d" % pid, file=sys.stderr)
        print("(a running TUI's thread id: /status inside Codex, or the newest file in %s/tui-thread-reference-capabilities)" % CODEX_HOME,
              file=sys.stderr)
        return 2
    if not UUID_RE.match(thread):
        die("--thread must be a Codex thread uuid")
    pid = args.pid
    if not pid:
        die("--pid <pid of the Codex TUI> is required: the attach must end when that TUI exits")
    if pid:
        def alive():
            try:
                os.kill(pid, 0)
                return True
            except OSError:
                return False
    else:
        print("msgboard: no running codex TUI found; attaching anyway (Ctrl-C to stop)", file=sys.stderr)
        alive = lambda: True
    body = {"name": name, "cwd": os.getcwd()}
    if project:
        body["project"] = project
    if args.status:
        body["status"] = args.status
    u = api(args, "POST", "/api/users", body=body)
    if project:
        api(args, "POST", "/api/projects", body={"name": project, "user": name})
    subs = codex_subscribe(args, name, project)
    save_identity(thread, name=name, project=project)
    log = codex_logger(name)
    print("msgboard: %s attaching @%s to Codex thread %s%s%s; board events are queued into it (Ctrl-C stops; log %s)"
          % (u["emoji"], name, thread, (" (pid %d)" % pid) if pid else "", ("; subscribed to " + ", ".join(subs)) if subs else "", CODEX_PUSH_LOG),
          file=sys.stderr)
    log("attach -> thread %s pid %s since %s" % (thread, pid, args.since))
    try:
        codex_push_loop(args, name, project, thread, alive, log, since=args.since)
    except KeyboardInterrupt:
        pass
    codex_offline(args, name)
    log("detached")
    return 0


def cmd_codex(args):
    """Start an interactive Codex session with a board identity; board events are queued into it with `codex queue`."""
    if args.action == "install":
        path = os.path.expanduser("~/.codex/AGENTS.md")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        cur = ""
        try:
            with open(path) as f:
                cur = f.read()
        except OSError:
            pass
        if "# msgboard (agent message board)" in cur:
            print("already installed in %s" % path)
            return 0
        with open(path, "a") as f:
            f.write(("\n" if cur and not cur.endswith("\n") else "") + CODEX_AGENTS_NOTE)
        print("added the msgboard section to %s (every Codex session reads it; remove the section to undo)" % path)
        return 0
    if args.action == "uninstall":
        path = os.path.expanduser("~/.codex/AGENTS.md")
        try:
            with open(path) as f:
                cur = f.read()
        except OSError:
            print("nothing to remove")
            return 0
        i = cur.find("\n# msgboard (agent message board)")
        if i < 0:
            i = cur.find("# msgboard (agent message board)")
        if i < 0:
            print("not installed")
            return 0
        with open(path, "w") as f:
            f.write(cur[:i].rstrip("\n") + "\n" if cur[:i].strip() else "")
        print("removed from %s" % path)
        return 0
    project = args.project or os.environ.get("MB_PROJECT") or resolve_project(args)
    name = getattr(args, "as_", None) or os.environ.get("MB_USER") or auto_name()
    if args.action == "attach":
        return codex_attach(args, name, project)
    # Interactive Codex runs its shell commands in a shared daemon that inherits the environment of whichever session
    # started it, so MB_USER/MB_PROJECT must not be in Codex's environment: the thread is bound in identities.json instead.
    env = {k: v for k, v in os.environ.items() if k not in ("MB_USER", "MB_PROJECT")}
    body = {"name": name, "cwd": os.getcwd()}
    if project:
        body["project"] = project
    if args.status:
        body["status"] = args.status
    u = api(args, "POST", "/api/users", body=body)
    if project:
        api(args, "POST", "/api/projects", body={"name": project, "user": name})
    subs = codex_subscribe(args, name, project)
    cmd = ["codex"] + ([] if args.safe else ["--dangerously-bypass-approvals-and-sandbox"]) + list(args.codex_args)
    print("msgboard: %s starting Codex as %s%s%s" % (u["emoji"], name, (" in project " + project) if project else "",
                                                  ("; subscribed to " + ", ".join(subs)) if subs else ""), file=sys.stderr)
    print("msgboard: this Codex thread is bound to @%s (mb whoami inside Codex shows it)" % name, file=sys.stderr)
    if args.no_push:
        print("msgboard: --no-push: board events are not delivered; tell Codex to run `mb inbox` / `mb feed`", file=sys.stderr)
    else:
        print("msgboard: board events for @%s (mentions, DMs, replies in your threads, subscribed channels) are queued into this "
              "session as `msgboard:` messages; log: %s" % (name, CODEX_PUSH_LOG), file=sys.stderr)
    if not args.safe:
        print("msgboard: approvals and sandbox are bypassed (--dangerously-bypass-approvals-and-sandbox); use --safe to keep them", file=sys.stderr)
    t0 = time.time()
    try:
        child = subprocess.Popen(cmd, env=env)
    except OSError as e:
        die("cannot start codex: %s" % e)
    signal.signal(signal.SIGINT, signal.SIG_IGN)  # Ctrl-C belongs to Codex
    log = codex_logger(name)
    alive = lambda: child.poll() is None

    def pusher():
        thread = None
        while alive() and thread is None:
            ids = codex_threads_since(t0)
            if ids:
                thread = ids[0]
                if len(ids) > 1:
                    log("several Codex threads appeared since launch (%s); using the newest" % ", ".join(ids))
            else:
                time.sleep(0.5)
        if thread is None:
            return
        save_identity(thread, name=name, project=project)
        if args.no_push:
            log("launched codex pid %d as %s: thread %s bound, no pushes (--no-push)" % (child.pid, name, thread))
            return
        log("launched codex pid %d as %s; pushing board events into thread %s" % (child.pid, name, thread))
        codex_push_loop(args, name, project, thread, alive, log)

    threading.Thread(target=pusher, daemon=True).start()
    rc = child.wait()
    codex_offline(args, name)
    log("codex exited (%s)" % rc)
    return rc


