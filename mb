def cmd_wait(args, follow=False):
    if getattr(args, "feed", False):
        return feed_loop(args, follow)
    me = resolve_user(args)
    mention = bool(args.mention)
    thread = getattr(args, "reply_to", None)
    peek = mention or bool(getattr(args, "peek", False)) or thread is not None
    channel = resolve_channel(args, args.channel, must_exist=True) if args.channel else None
    project = None if channel else (args.project or None)  # no channel + no -p = every channel; -p narrows
    since = args.since
    default_since = None
    if thread is not None and since is None:
        since = thread  # every reply after the root, so an answer that already landed is returned at once
    elif peek and since is None:
        h = health(args)
        if not h:
            die("server not reachable at %s. Start it with: mb serve -d" % base_url(args))
        since = h["latest_id"]
    deadline = time.monotonic() + args.timeout if getattr(args, "timeout", None) else None
    outage_started = None
    printed = {}      # channel -> highest id printed (re-deliveries after a lost response are not printed twice)
    unacked = {}      # channel -> highest id delivered but not yet acknowledged to the server

    def ack():
        for ch in list(unacked):
            try:
                api(args, "POST", "/api/channels/%s/read" % urllib.parse.quote(ch, safe=""),
                    body={"user": me, "last_id": unacked[ch]}, timeout=10, die_on_unreachable=False)
                del unacked[ch]
            except (Unreachable, SystemExit):
                pass  # retried after the next successful poll; until then the server re-delivers (at least once)
    if not args.quiet:
        what = ("replies to #%d" % thread) if thread is not None else ("mentions of @%s" % me if mention else "messages")
        where = channel or ("project %s" % project if project else "any channel")
        print("%s %s in %s as %s%s%s" % ("following" if follow else "waiting for", what, where, me,
                                         " (since #%d)" % since if since is not None else "",
                                         " (peek: read cursor untouched)" if peek and not mention and thread is None else ""),
              file=sys.stderr, flush=True)
    while True:
        poll = SERVER_MAX_POLL
        if deadline is not None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                if not args.quiet:
                    print("timeout: no new messages", file=sys.stderr, flush=True)
                return 124
            poll = max(1, min(poll, int(remaining + 0.999)))
        params = {"as": me, "channel": channel, "project": project, "mention": me if mention else None,
                  "thread": thread, "since": since, "default_since": default_since, "timeout": poll,
                  "limit": 500, "peek": "1" if peek else None, "ack": None if peek else "client",
                  "no_threads": "1" if getattr(args, "no_threads", False) else None}
        try:
            res = api(args, "GET", "/api/wait", params, timeout=poll + 15, die_on_unreachable=False)
        except Unreachable as e:
            if outage_started is None:
                outage_started = time.monotonic()
                if not args.quiet:
                    print("server unreachable (%s); retrying for up to %ds" % (e, RECONNECT_SECS),
                          file=sys.stderr, flush=True)
            if time.monotonic() - outage_started > RECONNECT_SECS:
                die("server not reachable at %s for %ds; giving up" % (base_url(args), RECONNECT_SECS), 2)
            time.sleep(1)
            continue
        if outage_started is not None and not args.quiet:
            print("server back", file=sys.stderr, flush=True)
        outage_started = None
        default_since = res["latest_id"]
        if unacked:
            ack()
        msgs = [m for m in res["messages"] if m["id"] > printed.get(m["channel"], 0)]
        if msgs:
            emit(msgs, args, show_channel=True)
            for m in msgs:
                printed[m["channel"]] = max(printed.get(m["channel"], 0), m["id"])
                if not peek:
                    unacked[m["channel"]] = max(unacked.get(m["channel"], 0), m["id"])
            if since is not None:
                since = msgs[-1]["id"]
            if not peek:
                ack()
            if not follow:
                return 0


