def feed_loop(args, follow):
    me = resolve_user(args)
    deadline = time.monotonic() + args.timeout if getattr(args, "timeout", None) else None
    outage_started = None
    if not args.quiet:
        print("%s the feed as %s (mentions, DMs, replies in your threads, subscribed channels)%s"
              % ("following" if follow else "waiting on", me, "; no timeout: exits only when something arrives" if not deadline else ""),
              file=sys.stderr, flush=True)
    while True:
        poll = SERVER_MAX_POLL
        if deadline is not None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                if not args.quiet:
                    print("timeout: nothing arrived", file=sys.stderr, flush=True)
                return 124
            poll = max(1, min(poll, int(remaining + 0.999)))
        try:
            api(args, "POST", "/api/presence", body={"user": me, "kind": "wait", "ttl": 90}, timeout=5, die_on_unreachable=False)
            res = api(args, "GET", "/api/feed/wait", {"as": me, "timeout": poll, "limit": 200}, timeout=poll + 15, die_on_unreachable=False)
        except Unreachable as e:
            if outage_started is None:
                outage_started = time.monotonic()
                if not args.quiet:
                    print("server unreachable (%s); retrying for up to %ds" % (e, RECONNECT_SECS), file=sys.stderr, flush=True)
            if time.monotonic() - outage_started > RECONNECT_SECS:
                die("server not reachable for %ds; giving up" % RECONNECT_SECS, 2)
            time.sleep(1)
            continue
        if outage_started is not None and not args.quiet:
            print("server back", file=sys.stderr, flush=True)
        outage_started = None
        msgs = res["messages"]
        if msgs:
            emit(msgs, args, show_channel=True)
            for _ in range(5):
                try:
                    api(args, "POST", "/api/feed/ack", body={"user": me, "last_id": msgs[-1]["id"]}, timeout=10, die_on_unreachable=False)
                    break
                except (Unreachable, SystemExit):
                    time.sleep(1)
            if not follow:
                return 0


CLAUDE_WAIT_PROMPT = """msgboard: you are @{name}{proj} on this machine; your identity is already set (`mb whoami` confirms it). \
Claude Code channels are not available here, so you keep yourself reachable: load the msgboard skill if it is installed \
(~/.claude/skills/msgboard/SKILL.md), run `mb brief`, then run `mb wait --feed` with the Bash tool in the background with no \
timeout. It costs nothing while waiting and exits only when something for you arrives (mentions, DMs, replies in your threads, \
subscribed channels{subs}): handle what it printed, answer on the board with mb (the authors read the board, not this terminal), \
and re-arm the same command. Never poll or loop on it. Between deliveries work on your tasks. \
Start now: brief, then arm the wait, then introduce yourself briefly in {intro}."""


def cmd_claude(args):
    """Start Claude Code for this agent: with the msgboard channel (events pushed into the session), or, where channels
    are not available (Bedrock / remote machines, or --no-channel), with an opening prompt that makes the session arm
    `mb wait --feed` itself."""
    project = args.project or os.environ.get("MB_PROJECT") or resolve_project(args)
    name = getattr(args, "as_", None) or os.environ.get("MB_USER") or auto_name()
    wait_mode = bool(args.no_channel or REMOTE or os.environ.get("CLAUDE_CODE_USE_BEDROCK") == "1"
                     or os.environ.get("CLAUDE_CODE_USE_VERTEX") == "1" or os.environ.get("CLAUDE_CODE_USE_FOUNDRY") == "1")
    env = dict(os.environ, MB_USER=name)
    if not wait_mode:
        env["MB_CHANNEL"] = "1"
    if project:
        env["MB_PROJECT"] = project
    body = {"name": name, "cwd": os.getcwd()}
    if project:
        body["project"] = project
    if args.status:
        body["status"] = args.status
    u = api(args, "POST", "/api/users", body=body)
    if project:
        api(args, "POST", "/api/projects", body={"name": project, "user": name})
    subs = []
    if wait_mode and project and not args.no_watch:
        subs.append(project + "/general")  # no channel to arm subscriptions from inside: the project chat is on from the start
    for ch in [c for c in (args.watch or "").replace(",", " ").split() if c]:
        key = resolve_channel(argparse.Namespace(as_=name, project=project, url=getattr(args, "url", None), token=getattr(args, "token", None)), ch, must_exist=True)
        if key not in subs:
            subs.append(key)
    for key in subs:
        api(args, "POST", "/api/subscriptions", body={"user": name, "channel": key})
    extra = list(args.claude_args)
    if extra and extra[0] == "--":
        extra = extra[1:]
    cmd = ["claude"] + ([] if args.safe else ["--dangerously-skip-permissions"]) + extra
    print("msgboard: %s %s as %s %s%s" % (u["emoji"], "starting Claude Code", name, ("in project " + project) if project else "",
                                        ("; subscribed to " + ", ".join(subs)) if subs else ""), file=sys.stderr)
    if wait_mode:
        why = "--no-channel" if args.no_channel else ("remote machine" if REMOTE else "third-party API provider")
        print("msgboard: no channel here (%s: Claude Code channels need Anthropic auth and are not available on Bedrock/Vertex/"
              "Foundry); the session arms `mb wait --feed` itself from an opening prompt and is woken once per delivery" % why,
              file=sys.stderr)
        cmd.append(CLAUDE_WAIT_PROMPT.format(name=name, proj=(" in project " + project) if project else "",
                                             subs=(": " + ", ".join(subs)) if subs else "",
                                             intro=(project + "/general") if project else "main/general"))
    else:
        spec = PLUGIN_SPEC
        flag = "--channels" if args.official else "--dangerously-load-development-channels"
        cmd[1:1] = [flag, spec]
        print("msgboard: board events for @%s will arrive in the session (mentions, DMs, replies in your threads%s)"
              % (name, ", subscribed channels" if subs else ""), file=sys.stderr)
        if not args.official:
            print("msgboard: confirm the development-channels dialog with \"I am using this for local development\"", file=sys.stderr)
    if not args.safe:
        print("msgboard: permissions are bypassed (--dangerously-skip-permissions); use --safe to keep prompts", file=sys.stderr)
    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as e:
        die("cannot start claude: %s" % e)


