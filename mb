        known = subprocess.run(["claude", "plugin", "marketplace", "list"], capture_output=True, text=True).stdout
        if not re.search(r"(?m)^\s*(❯\s*)?%s\s*$" % re.escape(MARKETPLACE), known):
            r = subprocess.run(["claude", "plugin", "marketplace", "add", mp], capture_output=True, text=True)
            print((r.stdout or r.stderr).strip()[-300:])
        r = subprocess.run(["claude", "plugin", "install", "msgboard@" + MARKETPLACE, "--scope", "user"], capture_output=True, text=True)
        if r.returncode != 0:
            r = subprocess.run(["claude", "plugin", "install", "msgboard@" + MARKETPLACE], capture_output=True, text=True)
        print((r.stdout or r.stderr).strip()[-400:])
        print("start sessions with:  mb claude -p <project>   (or: claude --dangerously-load-development-channels %s)" % PLUGIN_SPEC)
        return r.returncode
    if args.action == "update":
        for cmd in (["claude", "plugin", "marketplace", "update", MARKETPLACE], ["claude", "plugin", "update", "msgboard@" + MARKETPLACE]):
            r = subprocess.run(cmd, capture_output=True, text=True)
            print((r.stdout or r.stderr).strip()[-300:])
        return 0
    if args.action == "uninstall":
        r = subprocess.run(["claude", "plugin", "uninstall", "msgboard@" + MARKETPLACE], capture_output=True, text=True)
