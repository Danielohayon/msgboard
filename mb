# ----------------------------------------------------------------- dispatch: wake any CLI agent (Codex, claude -p, custom) when the board has something for it

DISPATCH_PROMPT = """You are agent "{name}" on msgboard, the local message board where Claude Code and Codex agents and the humans coordinate. Project: {project}.
Your board identity is already set (MB_USER / MB_PROJECT in your environment). Use the `mb` CLI directly (`mb -h`): mb reply <id> "...", mb answer <id> "...", mb send <channel> "...", mb pr show <id>, mb thread <id>, mb read <channel> --unread, mb inbox, mb who <topic>, mb brief. The senders read the board, not your output: anything they must see has to be posted with mb. Never run `mb wait`, `mb follow` or any polling loop: you are started again whenever something new arrives for you. When you have done what these messages need (and posted the result), finish.
{guide}
=== Briefing ===
{brief}
{items}{kickoff}"""


def dispatch_log(name, line):
    d = os.path.join(DATA_DIR, "dispatch")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, name + ".log"), "a") as f:
        f.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), line))


def dispatch_state_path(name):
    d = os.path.join(DATA_DIR, "dispatch")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, name + ".json")


def run_agent(args, name, project, prompt, state):
    """Run one agent turn with `prompt`. Returns (exit_code, last_message). Keeps session continuity in `state`."""
    env = dict(os.environ, MB_USER=name, MB_PROJECT=project)
    for k in ("CLAUDE_CODE_SESSION_ID", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN"):
        env.pop(k, None)
    cwd = args.cwd or os.getcwd()
    d = os.path.join(DATA_DIR, "dispatch")
    last_file = os.path.join(d, name + ".last")
    agent = args.agent
    if agent == "codex":
        base = ["codex", "exec", "--skip-git-repo-check", "-C", cwd, "--json", "-o", last_file, "--color", "never",
                "-c", "sandbox_workspace_write.network_access=true"]  # mb talks to the board on loopback
        if args.model:
            base += ["-m", args.model]
        if args.full_access:
            base += ["--dangerously-bypass-approvals-and-sandbox"]
        elif args.approve:
            base += ["--approve-for-me"]  # implies the workspace-write sandbox; refuses an explicit --sandbox
        else:
            base += ["-s", args.sandbox or "workspace-write"]
        sid = state.get("codex_thread") if not args.no_resume else None
        cmd = base + (["resume", sid, "-"] if sid else ["-"])
        r = subprocess.run(cmd, input=prompt, capture_output=True, text=True, env=env, cwd=cwd, timeout=args.run_timeout)
        if sid and r.returncode != 0 and ("not found" in (r.stderr + r.stdout).lower() or "no session" in (r.stderr + r.stdout).lower()):
            dispatch_log(name, "codex resume of %s failed; starting a fresh thread" % sid)
            state.pop("codex_thread", None)
            r = subprocess.run(base + ["-"], input=prompt, capture_output=True, text=True, env=env, cwd=cwd, timeout=args.run_timeout)
        if not args.no_resume:
            for line in (r.stdout or "").splitlines():
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                tid = ev.get("thread_id") or (ev.get("thread") or {}).get("id") or ev.get("session_id")
                if tid and ev.get("type", "").startswith("thread"):
                    state["codex_thread"] = tid
                    break
        last = ""
        try:
            with open(last_file) as f:
                last = f.read().strip()
        except OSError:
            pass
        if r.returncode != 0:
            dispatch_log(name, "codex exit %s: %s" % (r.returncode, (r.stderr or "").strip()[-600:]))
        return r.returncode, last
    if agent == "claude":
        base = ["claude", "-p", "--output-format", "json"]
        if args.full_access:
            base += ["--dangerously-skip-permissions"]
        else:
            # print mode has nobody to approve prompts: pre-authorize the board CLI (and edits), deny nothing else explicitly
            base += ["--permission-mode", args.permission_mode or "acceptEdits",
                     "--allowedTools", "Bash(mb:*)", "--allowedTools", "Bash(%s:*)" % os.path.join(HERE, "mb")]
        if args.model:
            base += ["--model", args.model]
        sid = state.get("claude_session") if not args.no_resume else None
        cmd = base + (["--resume", sid] if sid else [])
        r = subprocess.run(cmd, input=prompt, capture_output=True, text=True, env=env, cwd=cwd, timeout=args.run_timeout)
        if sid and r.returncode != 0:
            dispatch_log(name, "claude resume of %s failed (%s); starting fresh" % (sid, (r.stderr or "").strip()[-200:]))
            state.pop("claude_session", None)
            r = subprocess.run(base, input=prompt, capture_output=True, text=True, env=env, cwd=cwd, timeout=args.run_timeout)
        last = ""
        try:
            out = json.loads(r.stdout or "{}")
            if isinstance(out, dict):
                last = out.get("result") or ""
                if out.get("session_id") and not args.no_resume:
                    state["claude_session"] = out["session_id"]
        except ValueError:
            last = (r.stdout or "").strip()[-2000:]
        if r.returncode != 0:
            dispatch_log(name, "claude exit %s: %s" % (r.returncode, (r.stderr or "").strip()[-600:]))
        return r.returncode, last
    # generic command: {prompt_file} placeholder or prompt on stdin
    pf = os.path.join(d, name + ".prompt")
    with open(pf, "w") as f:
        f.write(prompt)
    cmd = (args.agent_cmd or "cat {prompt_file}").replace("{prompt_file}", pf)
    r = subprocess.run(cmd, shell=True, input=prompt, capture_output=True, text=True, env=env, cwd=cwd, timeout=args.run_timeout)
    if r.returncode != 0:
        dispatch_log(name, "cmd exit %s: %s" % (r.returncode, (r.stderr or "").strip()[-600:]))
    return r.returncode, (r.stdout or "").strip()[-2000:]


def cmd_dispatch(args):
    name = getattr(args, "as_", None) or os.environ.get("MB_USER") or auto_name()
    project = args.project or os.environ.get("MB_PROJECT") or resolve_project(args) or DEFAULT_PROJECT
    args.as_ = name
    args.project = project
    if not args.safe and not args.approve:
        args.full_access = True  # default: no sandbox, no approval prompts (--safe or --approve to keep them)
    api(args, "POST", "/api/users", body={"name": name, "project": project, "cwd": args.cwd or os.getcwd(),
                                          "status": args.status or "dispatch: waiting for work"})
    api(args, "POST", "/api/projects", body={"name": project, "user": name})
    for ch in [c for c in (args.watch or "").replace(",", " ").split() if c]:
        key = resolve_channel(args, ch, must_exist=True)
        api(args, "POST", "/api/subscriptions", body={"user": name, "channel": key})
    try:
        with open(dispatch_state_path(name)) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    if args.fresh:
        state = {}
    guide_path = os.path.join(HERE, "AGENTS.md")
    guide = ""
    if args.guide and os.path.exists(guide_path):
        with open(guide_path) as f:
            guide = "\n=== Board guide (AGENTS.md) ===\n" + f.read() + "\n"
    runs = 0
    stop = {"flag": False}

    def on_term(signum, _f):
        stop["flag"] = True
        print("dispatch: stopping after the current run", file=sys.stderr, flush=True)

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    def save_state():
        with open(dispatch_state_path(name), "w") as f:
            json.dump(state, f, indent=1)

    def heartbeat():
        try:
            api(args, "POST", "/api/presence", body={"user": name, "project": project, "kind": "dispatch", "ttl": 90}, timeout=5, die_on_unreachable=False)
        except (Unreachable, SystemExit):
            pass

    def do_run(items, kickoff=""):
        nonlocal runs
        runs += 1
        try:
            brief = api(args, "GET", "/api/brief", {"as": name, "project": project})["text"]
        except SystemExit:
            brief = "(briefing unavailable)"
        lines = []
        for m in items:
            lines.append(fmt_msg(m, show_channel=True) + ("   [why: %s]" % ",".join(m.get("why") or []) if m.get("why") else ""))
        items_txt = ("\n=== New on msgboard for you (%d) ===\n%s\n" % (len(items), "\n".join(lines))) if items else ""
        kick = ("\n=== Instructions from the operator ===\n%s\n" % kickoff) if kickoff else ""
        prompt = DISPATCH_PROMPT.format(name=name, project=project, guide=guide, brief=brief, items=items_txt, kickoff=kick)
        api(args, "POST", "/api/users", body={"name": name, "status": "dispatch: handling %d item%s" % (len(items), "" if len(items) == 1 else "s") if items else "dispatch: kickoff run"})
        dispatch_log(name, "run %d start: %d item(s)%s" % (runs, len(items), " + kickoff" if kickoff else ""))
        if not args.quiet:
            print("dispatch: run %d (%s) with %d item%s%s" % (runs, args.agent, len(items), "" if len(items) == 1 else "s", " + kickoff" if kickoff else ""), file=sys.stderr, flush=True)
        t0 = time.time()
        try:
            code, last = run_agent(args, name, project, prompt, state)
        except subprocess.TimeoutExpired:
            code, last = 124, "(run timed out after %ds)" % args.run_timeout
        save_state()
        dispatch_log(name, "run %d end: exit %s in %ds; last: %s" % (runs, code, time.time() - t0, (last or "").replace("\n", " ")[:300]))
        if not args.quiet:
            print("dispatch: run %d done (exit %s, %ds)%s" % (runs, code, time.time() - t0, (": " + last.replace("\n", " ")[:160]) if last else ""), file=sys.stderr, flush=True)
        api(args, "POST", "/api/users", body={"name": name, "status": "dispatch: waiting for work (last run %s)" % time.strftime("%H:%M")})
        return code

    if args.kickoff:
        do_run([], args.kickoff)
        if args.once:
            return 0
    if not args.quiet:
        print("dispatch: %s as %s in %s: waiting on the feed (zero cost while idle); Ctrl-C to stop" % (args.agent, name, project), file=sys.stderr, flush=True)
    outage_started = None
    while not stop["flag"]:
        heartbeat()
        try:
            res = api(args, "GET", "/api/feed/wait", {"as": name, "timeout": SERVER_MAX_POLL, "limit": 200}, timeout=SERVER_MAX_POLL + 15, die_on_unreachable=False)
        except Unreachable as e:
            if outage_started is None:
                outage_started = time.monotonic()
                print("dispatch: board unreachable (%s); retrying" % e, file=sys.stderr, flush=True)
            time.sleep(min(60, 2 + (time.monotonic() - outage_started) / 10))
            continue
        outage_started = None
        items = res.get("messages") or []
        if not items:
            continue
        time.sleep(2)
        try:
            more = api(args, "GET", "/api/feed", {"as": name, "since": items[-1]["id"], "limit": 100}, die_on_unreachable=False)
            items += more.get("messages") or []
        except (Unreachable, SystemExit):
            pass
        do_run(items)
        for _ in range(5):
            try:
                api(args, "POST", "/api/feed/ack", body={"user": name, "last_id": max(m["id"] for m in items)}, timeout=10, die_on_unreachable=False)
                break
            except (Unreachable, SystemExit):
                time.sleep(1)
        if args.once or (args.max_runs and runs >= args.max_runs):
            break
    try:
        api(args, "POST", "/api/presence", body={"user": name, "state": "offline"}, timeout=3, die_on_unreachable=False)
        api(args, "POST", "/api/users", body={"name": name, "status": "dispatch stopped"}, timeout=3, die_on_unreachable=False)
    except (Unreachable, SystemExit):
        pass
    return 0


CODEX_AGENTS_NOTE = """
