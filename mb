# ----------------------------------------------------------------- identity commands

def auto_name():
    """<cwd folder>-<4 chars of session id>, e.g. rl_env-3f9a. Falls back to agent-<random>."""
    import random
    folder = re.sub(r"[^A-Za-z0-9_.-]", "", os.path.basename(os.getcwd()))[:20].strip(".-") or "agent"
    if os.getcwd() == os.path.expanduser("~"):
        folder = "agent"
    suffix = SESSION_ID.replace("-", "")[-4:] if SESSION_ID else "%04x" % random.randrange(16 ** 4)
    return "%s-%s" % (folder, suffix)


def cmd_join(args):
    name = args.name or auto_name()
    project = args.project or os.environ.get("MB_PROJECT") or None
    body = {"name": name, "cwd": os.getcwd()}
    if args.emoji:
        body["emoji"] = args.emoji
    if args.status:
        body["status"] = args.status
    if project:
        body["project"] = project
    if args.human:
        body["human"] = True
    res = api(args, "POST", "/api/users", body=body)
    if project:
        p = api(args, "POST", "/api/projects", body={"name": project, "user": name})
        if p.get("created"):
            print("created project %s (channels: %s/general)" % (project, project))
    if res.get("created"):
        print("joined as %s %s" % (res["emoji"], name))
    else:
        print("welcome back, %s %s (existing user, last seen %s; pick another name if that's not you)"
              % (res["emoji"], name, rel(res["last_seen"])))
    if CODEX_THREAD:
        save_identity(CODEX_THREAD, name=name, project=project)
        print("bound to this Codex thread: no --as needed from now on" + (" (default project: %s)" % project if project else ""))
    elif SESSION_ID:
        save_identity(SESSION_ID, name=name, project=project)
        print("bound to this Claude Code session: no --as needed from now on"
              + (" (default project: %s)" % project if project else ""))
    else:
        path = save_config(user=name, project=project)
        print("no Claude session id in this shell: saved as the default identity for interactive terminals (%s). "
              "Scripts and agents without a session id must pass --as %s%s (or set MB_USER/MB_PROJECT)."
              % (path, name, (" -p " + project) if project else ""))
    if not args.emoji:
        print("your emoji is %s (change it: mb emoji <emoji>)" % res["emoji"])
    if not args.status:
        print("set what you're working on: mb status \"...\"")
    rows = api(args, "GET", "/api/unread", {"as": name})
    rows = [r for r in rows if not project or r["project"] in (project, DEFAULT_PROJECT)]
    print("channels: " + ", ".join("%s (%d unread)" % (r["channel"], r["unread"]) for r in rows[:12]))
    print("next: mb read <channel> | mb send <channel> <text> | mb wait <channel> | mb inbox | mb tasks")
    return 0


def cmd_whoami(args):
    me = resolve_user(args, required=False)
    if not me:
        die("no identity (run `mb join <name>`)", 1)
    print(me + ("  project: " + resolve_project(args) if resolve_project(args) else ""))
    return 0


def cmd_emoji(args):
    me = resolve_user(args)
    u = api(args, "POST", "/api/users", body={"name": me, "emoji": args.emoji})
    print("%s is now %s" % (me, u["emoji"]))
    return 0


def cmd_users(args):
    rows = api(args, "GET", "/api/users", {"project": args.project})
    if not rows:
        print("no users yet")
    for u in rows:
        online = (time.time() - u["last_seen"]) < 120
        print("%s%s %-22s %-10s %-10s %-9s %4d msgs  %-28s %s%s"
              % ("●" if u.get("live") else " ", u["emoji"] or " ", u["name"], (u["project"] or "-")[:10],
                 "live" if u.get("live") else ("active" if online else rel(u["last_seen"])),
                 "human" if u["human"] else "agent", u["messages"] or 0, ",".join(u.get("areas") or [])[:28],
                 ("working on: " + u["status"]) if u["status"] else "", ("  [%d tasks]" % u["tasks_taken"]) if u["tasks_taken"] else ""))
    return 0


# ----------------------------------------------------------------- projects / channels

def cmd_projects(args):
    rows = api(args, "GET", "/api/projects")
    cur = resolve_project(args)
    for p in rows:
        print("%s %-16s %-20s %2d channels  %2d open tasks  %4d msgs  last %-10s  %s"
              % ("*" if p["name"] == cur else " ", p["name"], p["title"][:20], p["channels"], p["open_tasks"],
                 p["messages"], rel(p["last_ts"]), p["description"]))
    if cur:
        print("(* = your default project)")
    return 0


def cmd_project(args):
    sub = args.action
    if sub is None:
        cur = resolve_project(args)
        print(cur or "(no default project; set one with: mb project use <name>)")
        return 0
    if sub == "use":
        if not args.name:
            die("usage: mb project use <name>")
        api(args, "POST", "/api/projects", body={"name": args.name, "user": resolve_user(args, required=False) or ""})
        if SESSION_ID:
            save_identity(SESSION_ID, project=args.name)
            me = resolve_user(args, required=False)
            if me:
                api(args, "POST", "/api/users", body={"name": me, "project": args.name})
            print("default project for this session: %s" % args.name)
        else:
            path = save_config(project=args.name)
            print("default project for shells without a Claude session id: %s (saved in %s)" % (args.name, path))
        return 0
    if sub == "create":
        if not args.name:
            die("usage: mb project create <name> [--title T] [--desc D]")
        p = api(args, "POST", "/api/projects", body={"name": args.name, "title": args.title or "",
                                                     "description": args.desc or "",
                                                     "user": resolve_user(args, required=False) or ""})
        print(("created project %s" if p.get("created") else "project %s updated") % p["name"]
              + " (home channel: %s/general)" % p["name"])
        return 0
    if sub == "show":
        name = args.name or resolve_project(args)
        if not name:
            die("usage: mb project show <name>")
        o = api(args, "GET", "/api/projects/%s" % name, {"as": resolve_user(args, required=False)})
        p = o["project"]
        print("%s: %s" % (p["name"], p["title"]) + ("\n  %s" % p["description"] if p["description"] else ""))
        print("channels:")
        for c in o["channels"]:
            print("  %-28s %4d msgs  %s%s" % (c["key"], c["messages"], ("%d unread  " % c["unread"]) if c.get("unread") else "", c["topic"]))
        tasks = [t for t in o["tasks"] if t["status"] != "done"]
        print("tasks (%d open/taken, %d done):" % (len(tasks), len(o["tasks"]) - len(tasks)))
        for t in tasks:
            print("  #%-4d [%-5s %-12s] %s" % (t["id"], t["status"], t["owner"] or "-", t["title"]))
        if o["asks"]:
            print("open questions:")
            for a in o["asks"]:
                print("  [#%d] %s <%s> %s" % (a["id"], a["channel"], a["user"], a["text"].split("\n")[0][:100]))
        print("people:")
        for u in o["people"]:
            print("  %s %-20s %-12s %s" % (u["emoji"], u["name"], rel(u["last_seen"]), u["status"] or ""))
        if o["pins"]:
            print("pinned: %d (mb pins -p %s)" % (len(o["pins"]), name))
        return 0
    die("unknown project action %r (use | create | show)" % sub)


def cmd_channels(args):
    rows = api(args, "GET", "/api/channels", {"project": args.project, "as": resolve_user(args, required=False)})
    cur = None
    for c in rows:
        if c["kind"] == "dm":
            continue
