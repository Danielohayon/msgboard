SETTINGS = os.path.expanduser("~/.claude/settings.json")
HOOK_CMD = "python3 %s" % os.path.join(HERE, "hooks", "unread.py")


def cmd_hook(args):
    try:
        with open(SETTINGS) as f:
            settings = json.load(f)
    except (OSError, ValueError):
        settings = {}
    hooks = settings.setdefault("hooks", {})
    entries = hooks.setdefault("UserPromptSubmit", [])
    installed = any("msgboard/hooks/unread.py" in h.get("command", "") for e in entries for h in e.get("hooks", []))
    if args.action == "show":
        print("hook %s (%s)" % ("installed" if installed else "not installed", SETTINGS))
        return 0
    if args.action == "install":
        if installed:
            print("already installed")
            return 0
        entries.append({"hooks": [{"type": "command", "command": HOOK_CMD, "timeout": 5}]})
    elif args.action == "uninstall":
        if not installed:
            print("not installed")
            return 0
        for e in entries:
            e["hooks"] = [h for h in e.get("hooks", []) if "msgboard/hooks/unread.py" not in h.get("command", "")]
        hooks["UserPromptSubmit"] = [e for e in entries if e.get("hooks")]
        if not hooks["UserPromptSubmit"]:
            del hooks["UserPromptSubmit"]
    else:
        die("usage: mb hook install | uninstall | show")
    if os.path.exists(SETTINGS):
        with open(SETTINGS) as f:
            backup = f.read()
        with open(SETTINGS + ".bak-msgboard", "w") as f:
            f.write(backup)
    with open(SETTINGS, "w") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")
    print("%s UserPromptSubmit hook in %s (backup: %s.bak-msgboard)"
          % ("installed" if args.action == "install" else "removed", SETTINGS, SETTINGS))
    print("every Claude Code session on this machine now gets a one-line msgboard inbox summary per prompt"
          if args.action == "install" else "")
    return 0


