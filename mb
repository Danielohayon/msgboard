def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, path)


def ssh_run(host, remote_cmd, stdin_data=None, timeout=120):
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=30", "-o", "LogLevel=ERROR", host, remote_cmd]
    return subprocess.run(cmd, input=stdin_data, capture_output=True, timeout=timeout)


def deploy_link(host, socket_path):
    """Copy mb + AGENTS.md + config.json to the remote machine in one ssh session."""
    import io
    import tarfile
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tar:
        tar.add(os.path.join(HERE, "mb"), arcname="mb")
        tar.add(os.path.join(HERE, "AGENTS.md"), arcname="AGENTS.md")
        if os.path.exists(os.path.join(HERE, "skill", "SKILL.md")):
            tar.add(os.path.join(HERE, "skill", "SKILL.md"), arcname="SKILL.md")
        cfg = json.dumps({"url": "unix://" + socket_path, "remote": host, "reconnect_secs": 900}, indent=1).encode()
        ti = tarfile.TarInfo("config.json.new")  # merged into the remote config so keys set there (user, project) survive
        ti.size = len(cfg)
        ti.mode = 0o600
        ti.mtime = int(time.time())
        tar.addfile(ti, io.BytesIO(cfg))
    remote = ("set -e; umask 077; mkdir -p ~/.local/bin ~/.msgboard; chmod 700 ~/.msgboard; "
              "tar -xf - -C ~/.msgboard; mv -f ~/.msgboard/mb ~/.local/bin/mb; chmod 755 ~/.local/bin/mb; "
              "python3 -c \"import json,os; p=os.path.expanduser('~/.msgboard/config.json'); n=p+'.new'; "
              "a=json.load(open(p)) if os.path.exists(p) else {}; a.update(json.load(open(n))); "
              "json.dump(a, open(p,'w'), indent=1); os.remove(n)\"; "
              "chmod 600 ~/.msgboard/config.json; "
              "if [ -f ~/.msgboard/SKILL.md ]; then mkdir -p ~/.claude/skills/msgboard && mv -f ~/.msgboard/SKILL.md ~/.claude/skills/msgboard/SKILL.md; fi; "
              "echo \"deployed: $HOME/.local/bin/mb, $HOME/.msgboard/{config.json,AGENTS.md}, $HOME/.claude/skills/msgboard/SKILL.md\"; "
              "python3 --version")
    r = ssh_run(host, remote, stdin_data=buf.getvalue())
    if r.returncode != 0:
        die("deploy to %s failed: %s" % (host, r.stderr.decode(errors="replace").strip()[-400:]))
    print(r.stdout.decode(errors="replace").strip())


def service_installed(name):
    return os.path.exists(os.path.join(LAUNCH_DIR, SERVICES[name][0] + ".plist"))


def launchctl(*a, check=False):
    return subprocess.run(["launchctl"] + list(a), capture_output=True, text=True, check=check)


def service_restart(name):
    if service_installed(name):
        launchctl("kickstart", "-k", "gui/%d/%s" % (os.getuid(), SERVICES[name][0]))
        return True
    return False


def cmd_link(args):
    a = args.action
    links = load_json(LINKS_FILE, {})
    if a == "add":
        if not args.host:
            die("usage: mb link add <ssh-host> [--socket PATH] [--interval SEC] [--no-deploy]")
        host = args.host
        sock = args.socket
        if not sock:
            print("resolving the home directory on %s ..." % host, flush=True)
            r = ssh_run(host, "echo $HOME")
            if r.returncode != 0:
                die("cannot ssh to %s: %s" % (host, r.stderr.decode(errors="replace").strip()[-300:]))
            sock = r.stdout.decode().strip() + "/.msgboard/board.sock"
        if not args.no_deploy:
            print("deploying mb to %s ..." % host, flush=True)
            deploy_link(host, sock)
        links[host] = {"host": host, "socket": sock, "check_interval": args.interval or 30, "enabled": True,
                       "added": time.time()}
        save_json(LINKS_FILE, links)
        print("link %s -> %s registered" % (host, sock))
        if service_restart("links"):
            print("link supervisor restarted (launchd); watch it with: mb link status")
        else:
            print("start the supervisor: mb service install   (or by hand: python3 %s/link.py)" % HERE)
        return 0
    if a == "remove":
        if not args.host or args.host not in links:
            die("usage: mb link remove <host>   (known: %s)" % ", ".join(links) or "none")
        del links[args.host]
        save_json(LINKS_FILE, links)
        print("link %s removed" % args.host)
        service_restart("links")
        return 0
    if a == "deploy":
        if not args.host or args.host not in links:
            die("usage: mb link deploy <host>   (add it first with: mb link add <host>)")
        deploy_link(args.host, links[args.host]["socket"])
        return 0
    if a == "check":
        if not args.host or args.host not in links:
            die("usage: mb link check <host>")
        script = ("import socket,sys\np=sys.argv[1]\ns=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(15);s.connect(p)\n"
                  "s.sendall(b'GET /api/health HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n');d=b''\n"
                  "while True:\n c=s.recv(65536)\n if not c: break\n d+=c\nprint(d.split(b'\\r\\n')[0].decode())\n")
        t0 = time.time()
        r = ssh_run(args.host, "python3 - %s" % links[args.host]["socket"], stdin_data=script.encode())
        out = (r.stdout.decode(errors="replace").strip() or r.stderr.decode(errors="replace").strip()[-300:])
        print("%s: %s (%.1fs, new ssh session)" % (args.host, out, time.time() - t0))
        return 0 if "200" in out else 1
    if a == "log":
        subprocess.run(["tail", "-n", str(args.lines or 40), os.path.join(DATA_DIR, "links.log")])
        return 0
    # status
    st = load_json(LINKS_STATE, {})
    if not links:
        print("no links configured (mb link add <ssh-host>)")
        return 0
    sup = launchctl("print", "gui/%d/%s" % (os.getuid(), SERVICES["links"][0]))
    running = "state = running" in sup.stdout
    print("supervisor: %s" % ("running (launchd)" if running else ("installed but not running" if service_installed("links") else "not installed (mb service install)")))
    for name, cfg in links.items():
        L = st.get(name)
        if not L:
            print("  %-24s (no state yet)" % name)
            continue
        print("  %-24s %-11s for %-8s last ok %-10s restarts %-3s %s"
              % (name, L["state"], fmt_dur(time.time() - L["since"]),
                 (fmt_dur(time.time() - L["last_ok"]) + " ago") if L.get("last_ok") else "never",
                 max(L.get("restarts", 0), 0), ("  " + L["last_error"][:70]) if L.get("last_error") and L["state"] != "up" else ""))
    return 0


def plist_xml(label, script, logfile):
    return """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>%s</string>
  <key>ProgramArguments</key><array><string>%s</string><string>%s</string></array>
  <key>WorkingDirectory</key><string>%s</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>%s</string><key>HOME</key><string>%s</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>%s</string>
  <key>StandardErrorPath</key><string>%s</string>
</dict></plist>
""" % (label, sys.executable, os.path.join(HERE, script), HERE, LAUNCH_PATH, os.path.expanduser("~"), logfile, logfile)


def cmd_service(args):
    which = ["server", "links"] if args.which in (None, "all") else [args.which]
    uid = os.getuid()
    if args.action == "install":
        os.makedirs(LAUNCH_DIR, exist_ok=True)
        for name in which:
            label, script = SERVICES[name]
            plist = os.path.join(LAUNCH_DIR, label + ".plist")
            if name == "server":
                h = health(args)
                if h and h.get("pid"):
                    print("stopping the hand-started server (pid %s) so launchd can own it" % h["pid"])
                    try:
                        os.kill(int(h["pid"]), signal.SIGTERM)
                    except OSError:
                        pass
                    for _ in range(50):
                        time.sleep(0.1)
                        if not health(args):
                            break
            with open(plist, "w") as f:
                f.write(plist_xml(label, script, os.path.join(DATA_DIR, "%s.launchd.log" % name)))
            launchctl("bootout", "gui/%d/%s" % (uid, label))
            r = launchctl("bootstrap", "gui/%d" % uid, plist)
            if r.returncode != 0:
                die("launchctl bootstrap failed for %s: %s" % (label, (r.stderr or r.stdout).strip()))
            print("installed %s (%s)" % (label, plist))
        if "server" in which:
            for _ in range(80):
                time.sleep(0.1)
                if health(args):
                    print("server is up under launchd at %s" % base_url(args))
                    break
            else:
                print("server did not answer within 8s; see %s" % os.path.join(DATA_DIR, "server.launchd.log"))
        return 0
    if args.action == "uninstall":
        for name in which:
            label, _ = SERVICES[name]
            launchctl("bootout", "gui/%d/%s" % (uid, label))
            plist = os.path.join(LAUNCH_DIR, label + ".plist")
            if os.path.exists(plist):
                os.remove(plist)
            print("removed %s" % label)
        return 0
    if args.action == "restart":
        for name in which:
            print("%s: %s" % (name, "restarted" if service_restart(name) else "not installed"))
        return 0
    for name in which:
        label, _ = SERVICES[name]
        r = launchctl("print", "gui/%d/%s" % (uid, label))
        if r.returncode != 0:
            print("%-7s %s: %s" % (name, label, "not installed" if not service_installed(name) else "not loaded"))
            continue
        st = next((l.strip() for l in r.stdout.splitlines() if l.strip().startswith("state =")), "state = ?")
        pid = next((l.strip() for l in r.stdout.splitlines() if l.strip().startswith("pid =")), "")
        print("%-7s %s: %s %s" % (name, label, st, pid))
    return 0


